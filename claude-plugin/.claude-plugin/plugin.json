{
  "name": "cmssy",
  "displayName": "Cmssy",
  "version": "0.95.0",
  "description": "Run a Cmssy workspace from Claude: pages, records, media, forms, products, orders, refunds and discounts.",
  "author": {
    "name": "Cmssy",
    "email": "contact@cmssy.com",
    "url": "https://www.cmssy.com"
  },
  "homepage": "https://www.cmssy.com/docs/api/mcp",
  "repository": "https://github.com/cmssy-io/cmssy-mcp",
  "license": "MIT",
  "keywords": ["cms", "headless-cms", "ecommerce", "orders", "nextjs", "astro"],
  "icon": "./icon.png",
  "documentationUrl": "https://www.cmssy.com/docs/api/mcp",
  "supportUrl": "https://github.com/cmssy-io/cmssy-mcp/issues",
  "privacyPolicyUrl": "https://www.cmssy.com/privacy",
  "termsOfServiceUrl": "https://www.cmssy.com/terms",
  "userConfig": {
    "api_token": {
      "type": "string",
      "title": "API token",
      "description": "Workspace API token from Dashboard > API Tokens. Starts with cs_. The agent acts with the permissions of the member who created it.",
      "sensitive": true,
      "required": true
    },
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID",
      "description": "From Workspace Settings > General.",
      "required": true
    }
  },
  "mcpServers": {
    "cmssy": {
      "command": "npx",
      "args": ["-y", "@cmssy/mcp-server@0.95.0"],
      "env": {
        "CMSSY_API_TOKEN": "${user_config.api_token}",
        "CMSSY_WORKSPACE_ID": "${user_config.workspace_id}"
      }
    }
  }
}
